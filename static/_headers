# SvelteKit immutable assets — fingerprinted filenames, cache forever
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — always revalidate from edge (Cloudflare serves from cache, browser checks freshness)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# JSON data downloads — cache 1 hour, revalidate
/data/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Superseded releases and sidecars remain downloadable archives, but must not compete with V9.
