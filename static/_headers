# CSV data downloads — cache 1 hour, revalidate
/data/*.csv
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# LLM context files — cache 1 hour
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600

# Cloudflare Pages default and preview hosts — keep duplicate Pages URLs out of search
https://aiworkindex.pages.dev/*
  X-Robots-Tag: noindex
  Link: <https://aiworkindex.com/:splat>; rel="canonical"

https://:version.aiworkindex.pages.dev/*
  X-Robots-Tag: noindex
  Link: <https://aiworkindex.com/:splat>; rel="canonical"

# Security headers — all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
