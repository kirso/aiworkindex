	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:release-data": "bun run scripts/build-labour-monitor.ts && bun run scripts/build-industry-context.ts && bun run scripts/build-worker-profile.ts && bun run scripts/build-ai-in-singapore.ts && bun run scripts/score.ts && bun run scripts/enrich-bls-employment.ts && bun run scripts/enrich-sg-context.ts && bun run scripts/export-json.ts && bun run scripts/export-csv.ts && bun run scripts/export-context-pack.ts && bun run scripts/build-transition-support.ts && bun run scripts/build-claims-matrix.ts && bun run scripts/build-raw-data-audit.ts && bun run scripts/build-release-manifest.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "bun run scripts/validate.ts",
		"export:json": "bun run scripts/export-json.ts",
		"export:context": "bun run scripts/build-ai-in-singapore.ts && bun run scripts/export-context-pack.ts",
		"export:claims": "bun run scripts/build-claims-matrix.ts",
		"export:transitions": "bun run scripts/build-transition-support.ts",
		"export:manifest": "bun run scripts/build-release-manifest.ts",
		"export:raw-audit": "bun run scripts/build-raw-data-audit.ts",
		"verify": "bun run check && bun run lint && bun run format:check && bun run validate"
	},
